# Copy to frontend/.env. The frontend container reads this file.
# Server-side API base (inside Docker)
NUXT_API_BASE_INTERNAL=http://backend:8000/api/v1
# Browser calls the backend port published by deploy/docker-compose.dev.yml
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Dev server image directory. Production uses NUXT_IPX_FS_DIR (see .env.production.example).
NUXT_IMAGE_DIR=/media
NUXT_IPX_FS_DIR=/media
