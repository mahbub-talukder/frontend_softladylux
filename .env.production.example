# Copy to frontend/.env on the server. The frontend container reads this file.
NUXT_API_BASE_INTERNAL=http://backend:8000/api/v1
# Same origin behind nginx.
NUXT_PUBLIC_API_BASE=/api/v1
# Public origin for sitemap.xml, canonical links, and structured data.
NUXT_PUBLIC_SITE_URL=https://REPLACE_ME.example.com
# Nuxt Image reads originals from the shared media volume.
NUXT_IPX_FS_DIR=/media
